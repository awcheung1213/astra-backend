# Flat KEY=VALUE pairs — the same variable NAMES in every environment, only
# values differ. Locally: copy to .env (git-ignored; docker compose injects it
# via env_file). On Railway: each service's variables per environment.

ENVIRONMENT=local

# local.py hardcodes the docker-compose database — no DATABASE_* needed locally.
# staging/production require:
# DATABASE_HOST=
# DATABASE_NAME=
# DATABASE_USERNAME=
# DATABASE_PASSWORD=
# DATABASE_PORT=5432
# CORS_ORIGINS=https://app.example.com

# Coming as the build progresses (design doc: auth + adapters):
# SUPABASE_URL=
# TOKEN_ENCRYPTION_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# R2_ACCOUNT_ID= / R2_ACCESS_KEY_ID= / R2_SECRET_ACCESS_KEY=
# RESEND_API_KEY= / TWILIO_ACCOUNT_SID= / TWILIO_AUTH_TOKEN=
